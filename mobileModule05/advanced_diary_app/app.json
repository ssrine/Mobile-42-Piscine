{
  "expo": {
    "name": "Advanced Diary",
    "slug": "advanced-diary-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "test04-diary",
    "splash": {
      "backgroundColor": "#FFF8F0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.test04.diary",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.googleusercontent.apps.509050455059-crajrt6pvtnpmmm7at055tg90k6juscc",
              "host": "oauth2redirect"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.test04.diary",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.509050455059-8jkofidtp3irnpvj965uepl5hf485k0d"
            ]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "a6889b5b-c1ff-4b4e-b179-f49d12394536"
      }
    },
    "plugins": [
      "expo-web-browser"
    ],
    "owner": "harkani"
  }
}